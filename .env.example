# Copy this file to .env for local build testing.
# Commit this example file, but do not commit real project values.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_REQUEST_TIMEOUT_MS=2500

# Never put SUPABASE_SECRET_KEY, database passwords, or service_role keys in this frontend app.
# Those belong only in a backend server or Supabase Edge Function.
